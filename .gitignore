# --- Virtual environments (never commit: hundreds of MB) ---
.venv/
venv/
env/

# --- Model caches: run_experiments.sh defaults HF_HOME to $PWD/.hf_cache.
#     A single 7B model in fp16 weighs ~15 GB. ---
.hf_cache/
*.safetensors
*.gguf
*.sif

# --- Experiment outputs: heavy, and they embed the generated scripts ---
results/
results*.json
*.log

# Generated scripts awaiting verification. `make generate` writes them under
# results/, but a stray gen.jsonl in the root is easy to commit by accident -
# and a stale one is worse than none: it predates whatever bug you just fixed.
gen*.jsonl
generations*.jsonl

# --- Archives dropped into the working tree (downloaded snapshots, backups) ---
*.tar.gz
*.tgz
*.zip

# NOTE: `sweep/` (litsweep.py output) is deliberately NOT ignored.
# It is small text and it is the documentary evidence of the literature review:
# it makes the review reproducible and citable in the paper.

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.coverage

# --- OS / editors ---
.DS_Store
.idea/
.vscode/
*.swp

# --- LaTeX intermediates ---
# `anvil.pdf` is tracked, the rest is regenerated. `anvil.bbl` is not an exception even
# though the arXiv package needs it: arXiv does not run BibTeX and uses whatever `.bbl`
# the upload contains, so `make arxiv` regenerates it rather than trusting a stale one.
paper/*.aux
paper/*.bbl
paper/*.out
paper/*.log
# Derived from the manuscript by `make arxiv`, for pasting into the submission form.
paper/abstract.txt

# --- Secrets ---
.env
