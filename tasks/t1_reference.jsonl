{"id": "t1_hello_serial", "script": "#!/bin/bash\n#SBATCH --job-name=hello\n#SBATCH --nodes=1\n#SBATCH --ntasks=1\n#SBATCH --time=00:10:00\n#SBATCH --mem=512M\n\necho ANVIL_OK\n"}
{"id": "t1_cpus_per_task", "script": "#!/bin/bash\n#SBATCH --job-name=threads\n#SBATCH --nodes=1\n#SBATCH --ntasks=1\n#SBATCH --cpus-per-task=4\n#SBATCH --time=00:30:00\n#SBATCH --mem=2G\n\nexport OMP_NUM_THREADS=${SLURM_CPUS_PER_TASK:-4}\necho \"THREADS=${OMP_NUM_THREADS}\"\necho ANVIL_OK\n"}
{"id": "t1_array_job", "script": "#!/bin/bash\n#SBATCH --job-name=arr\n#SBATCH --nodes=1\n#SBATCH --array=1-5\n#SBATCH --time=00:15:00\n#SBATCH --mem=1G\n\nidx=${SLURM_ARRAY_TASK_ID:-1}\necho \"TASK=${idx}\"\necho ANVIL_OK\n"}
{"id": "t1_output_paths", "script": "#!/bin/bash\n#SBATCH --job-name=io_test\n#SBATCH --nodes=1\n#SBATCH --output=logs/out_%j.txt\n#SBATCH --error=logs/err_%j.txt\n#SBATCH --time=00:20:00\n#SBATCH --mem=1G\n\nmkdir -p logs\necho ANVIL_OK\n"}
{"id": "t1_gpu_single", "script": "#!/bin/bash\n#SBATCH --job-name=gpu\n#SBATCH --nodes=1\n#SBATCH --cpus-per-task=8\n#SBATCH --gpus=1\n#SBATCH --time=02:00:00\n#SBATCH --mem=16G\n\necho \"GPUS=${CUDA_VISIBLE_DEVICES:-}\"\necho ANVIL_OK\n"}
{"id": "t1_mpi_multinode", "script": "#!/bin/bash\n#SBATCH --job-name=mpi\n#SBATCH --nodes=2\n#SBATCH --ntasks=4\n#SBATCH --time=00:30:00\n#SBATCH --mem=4G\n\necho \"RANKS=${SLURM_NTASKS:-4}\"\necho ANVIL_OK\n"}
{"id": "t1_dependency_chain", "script": "#!/bin/bash\n#SBATCH --job-name=stage2\n#SBATCH --nodes=1\n#SBATCH --dependency=afterok:12345\n#SBATCH --time=00:25:00\n#SBATCH --mem=2G\n\necho ANVIL_OK\n"}
{"id": "t1_container_apptainer", "script": "#!/bin/bash\n#SBATCH --job-name=ctr\n#SBATCH --nodes=1\n#SBATCH --ntasks=1\n#SBATCH --time=00:45:00\n#SBATCH --mem=8G\n\nif command -v apptainer >/dev/null 2>&1; then\n  apptainer exec --bind /scratch/data:/data /opt/images/app.sif echo ANVIL_OK\nelse\n  echo NO_APPTAINER\n  echo ANVIL_OK\nfi\n"}
